<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="navbar-brand ms-5">
    <%= link_to root_path do %>
      <%= image_tag("logo.svg", alt: "Cart", class: 'navbar-brand', style: "width: 90px; height: auto;") %>
    <% end %>
 </div>
  <%= link_to 'Products', root_path, class: 'navbar-brand' %>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="navbarSupportedContent">
    <ul class="navbar-nav me-auto">
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to 'Users', user_index_path, class: 'nav-link' %>
          <%= link_to 'Orders', orders_path, class: 'nav-link' %>
          <%= link_to "Add Product", new_product_path, class: "nav-link" %>
        <% end %>
      <% end %>
    </ul>
    <% if user_signed_in? %>
      <ul class="navbar-nav ms-auto">
        <li class="cart me-4">
          <%= link_to edit_user_registration_path do %>
            <% if current_user.image.attached? %>
              <%= image_tag(current_user.image, alt: "Account", class: "rounded-circle ", style: "object-fit: cover; width: 40px; height: 40px;") %>
            <% else %>
              <%= image_tag("account.png", alt: "Cart", style: "width: 40px; height: auto;") %>
            <% end %>
          <% end %>
        </li>
        <li class="cart me-4">
          <%= link_to carts_path do %>
            <%= image_tag("cart.svg", alt: "Cart", style: "width: 40px; height: auto;") %>
          <% end %>
        </li>
        <%= button_to 'Log-out', destroy_user_session_path, method: :delete, class: 'btn btn-danger me-3' %>
      </ul>
    <% else %>
      <ul class="navbar-nav ms-auto">
        <%= link_to 'Log-in', new_user_session_path, class: 'btn btn-primary me-3' %>
        <%= link_to 'Sign-up', new_user_registration_path, class: 'btn btn-success me-3' %>
      </ul>
    <% end %>
  </div>
</nav>
