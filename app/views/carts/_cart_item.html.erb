<div class="container mt-4">
  <!-- Error Messages -->
  <% if !@order_item.nil? && @order_item.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @order_item.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @order_items.size > 0 %>
    <% @order_items.each do |f| %>
      <div class="card mb-4 border-light shadow-sm">
        <div class="row g-3">
          <div class="col-md-4">
            <%= image_tag(f.product.photo, class: "img-fluid rounded", alt: "Product image", style: "object-fit: cover; height: 200px; width: 100%;") %>
          </div>
          <div class="col-md-8">
            <div class="card-body">
              <h3 class="card-title"><%= f.product.name %></h3>
              <p class="card-text"><%= number_to_currency(f.product.price, unit: "$") %></p>
              <div class="d-flex justify-content-between align-items-center mb-3">
                <%= form_for(f, remote: true, html: { class: "d-flex align-items-center" }) do |i| %>
                  <%= i.hidden_field :product_id, value: f.product_id %>
                  <div class="input-group me-2">
                    <%= i.text_field :quantity, value: f.quantity.to_i, min: 1, class: "form-control" %>
                  </div>
                  <%= i.submit "Update", class: "btn btn-primary ms-2" %>
                <% end %>
                <span class="fw-bold">Total: <%= number_to_currency(f.total_price, unit: "$") %></span>
                <%= button_to "Delete", order_item_path(f), method: :delete, remote: true, class: "btn btn-danger" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
     <div class="empty-cart text-center mt-5">
      <h2 class="text-muted mb-4">Your Cart is Empty</h2>
      <p class="text-muted mb-4">Looks like you haven't added anything to your cart yet.</p>
      <%= link_to "Continue Shopping", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
