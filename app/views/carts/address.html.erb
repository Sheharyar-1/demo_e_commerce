<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h4 class="card-title mb-4 text-center" style="font-weight: bold;">Address Details</h4>
          <%= form_for @order, url: placed_order_path(@order), method: :patch do |f| %>
            <div class="mb-3">
              <%= f.label :shipping, "Shipping Address", class: "form-label" %>
              <%= f.text_field :shipping, class: "form-control form-control-lg" %>
            </div>

            <div class="mb-3">
              <%= f.label :billing, "Billing Address", class: "form-label" %>
              <%= f.text_field :billing, class: "form-control form-control-lg" %>
            </div>

            <div class="text-center">
              <%= f.submit "Place Order", class: "btn btn-warning btn-lg w-100 text-uppercase font-weight-bold" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
