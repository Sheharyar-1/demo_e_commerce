<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header">
          <h2 class="text-center card-title">Edit Profile</h2>
        </div>
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :name, class: 'form-label' %>
              <%= f.text_field :name, class: 'form-control', required: true %>
              <div class="invalid-feedback">
                Please provide your name.
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: 'form-label' %>
              <%= f.email_field :email, class: 'form-control', autofocus: true, autocomplete: "email", required: true %>
              <div class="invalid-feedback">
                Please provide a valid email.
              </div>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-info">
                Currently waiting confirmation for: <%= resource.unconfirmed_email %>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :new_password, "New Password", class: 'form-label' %>
              <%= f.password_field :password, class: 'form-control', autocomplete: "new-password" %>
              <div class="invalid-feedback">
                Please provide a new password.
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :new_password_confirmation, "Confirm New Password", class: 'form-label' %>
              <%= f.password_field :password_confirmation, class: 'form-control', autocomplete: "new-password" %>
              <div class="invalid-feedback">
                Please confirm your new password.
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :current_password, "Current Password", class: 'form-label' %>
              <%= f.password_field :current_password, class: 'form-control', autocomplete: "current-password" %>
              <div class="invalid-feedback">
                Please provide your current password.
              </div>
            </div>

            <div>
              <%= f.submit "Update", class: 'btn btn-primary' %>
            </div>
          <% end %>

          <div class="mt-4">
            <h3>Delete my account</h3>
            <div class="alert alert-danger">
              Unhappy? 
              <%= button_to "Delete my account", registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete, class: "btn btn-danger mt-2" %>
            </div>
          </div>

          <%= link_to "Back", :back, class: "btn btn-secondary mt-3" %>
        </div>
      </div>
    </div>
  </div>
</div>
