<div class="container mt-5">
  <h1 class="mb-4 text-center">Your Orders</h1>
  <div class="row justify-content-center">
    <div class="col-lg-12">
      <div class="card shadow-sm border-light">
        <div class="card-body p-4">
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr class="text-center">
                <th scope="col" class="py-3">Order ID</th>
                <th scope="col" class="py-3">User ID</th>
                <th scope="col" class="py-3">User Name</th>
                <th scope="col" class="py-3">Total Amount</th>
                <th scope="col" class="py-3" style="width: 200px;">Status</th>
              </tr>
            </thead>
            <tbody>
              <% @orders.each do |order| %>
                <tr class="align-middle text-center">
                  <th scope="row" class="py-3 text-primary" style="font-size: 1.1rem;"><%= order.id %></th>
                  <td class="py-3"><%= order.user_id %></td>
                  <td class="py-3"><%= order.user.name %></td>
                  <td class="py-3 text-danger" style="font-weight: bold;"><%= number_to_currency(order.subtotal) %></td>
                  <td class="py-3">
                    <%= form_with(model: order, url: order_path(order), method: :patch, local: true, class: "d-inline") do |f| %>
                      <div class="d-flex">
                        <div class="form-group mb-0" style="flex: 1;">
                          <%= f.select :status, Order.statuses.keys.map { |k| [k.humanize, k] }, {}, class: "form-control form-control-sm" %>
                        </div>
                        <div class="ml-2">
                          <%= f.submit "Update", class: "btn btn-primary btn-sm" %>
                        </div>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
