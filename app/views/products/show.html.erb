<div class="container mt-4">
  <div class="row">
    <div class="col-md-4">
      <div class="card">
        <% if @product.photo.attached? %>
          <%= image_tag(@product.photo, class: "card-img-top", alt: "Card image cap") %>
        <% else %>
          <%= image_tag("no.jpg", class: "card-img-top", alt: "Card image cap") %>
        <% end %>
      </div>
    </div>
    <div class="col-md-8">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="card-title"><%= @product.name %></h2>
          <p class="card-text"><%= @product.description %></p>
          <h4 class="card-text text-danger"><%= @product.price %>$</h4>
            <% if current_user.admin? || current_user.staff?%>
              <%= link_to "Update", edit_product_path(@product), class: "btn btn-primary mt-3" %>
            <% end %>

            <% if current_user.admin?%>
              <%= button_to "Destroy", product_path(@product), class: "btn btn-danger mt-3", method: :delete, data: { confirm: "Are you sure?" } %>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
