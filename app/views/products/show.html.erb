<div class="container mt-4">
  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card border-0 shadow-sm">
        <% if @product.photo.attached? %>
          <%= image_tag(@product.photo, class: "card-img-top", alt: "Product image", style: "width: 100%; height: auto; object-fit: cover;") %>
        <% else %>
          <%= image_tag("no.jpg", class: "card-img-top", alt: "No image available", style: "width: 100%; height: auto; object-fit: cover;") %>
        <% end %>
      </div>
    </div>
    <div class="col-md-6 mb-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h2 class="card-title mb-3"><%= @product.name %></h2>
          <p class="card-text mb-4"><%= @product.description %></p>
          <h4 class="text-danger mb-4"><%= number_to_currency(@product.price, unit: "$") %></h4>
          
          <div class="d-flex justify-content-between mb-3">
            <% if current_user.admin? || current_user.staff? %>
              <%= link_to "Update", edit_product_path(@product), class: "btn btn-primary" %>
            <% end %>

            <% if current_user.admin? %>
              <%= button_to "Destroy", product_path(@product), class: "btn btn-danger", method: :delete, data: { confirm: "Are you sure?" } %>
            <% end %>
          </div>

          <!-- Optional: Add a Buy Now button or other actions -->
          <%= button_to 'Buy Now', product_path(@product), class: 'btn btn-success w-100', method: :get %>
        </div>
      </div>
    </div>
  </div>
</div>
