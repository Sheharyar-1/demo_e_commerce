<div class="container mt-4">
  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card border-0 shadow-sm">
        <% if @product.photo.attached? %>
          <%= image_tag(@product.photo, class: "card-img-top", alt: "Product image", style: "width: 100%; height: auto; object-fit: cover; border-radius: 8px;") %>
        <% else %>
          <%= image_tag("no.jpg", class: "card-img-top", alt: "No image available", style: "width: 100%; height: auto; object-fit: cover; border-radius: 8px;") %>
        <% end %>
      </div>
    </div>
    <div class="col-md-6 mb-4">
      <div class="card border-0 shadow-sm h-100 p-4">
        <div class="card-body">
          <h2 class="card-title mb-3" style="font-weight: bold;"><%= @product.name %></h2>
          <p class="card-text mb-4" style="font-size: 16px;"><%= @product.description %></p>
          <h4 class="text-danger mb-4" style="font-size: 24px; font-weight: bold;"><%= number_to_currency(@product.price, unit: "$") %></h4>
          <% if @product.stock > 10 %>
            <p class="text-success mb-4" style="font-weight: bold;">
              <%= @product.stock %> In Stock
            </p>
          <% else %>
            <% if @product.stock > 1 %>
              <p class="text-danger mb-4" style="font-weight: bold;">
                Only <%= @product.stock %> left in stock
              </p>
            <% else %>
              <p class="text-danger mb-4" style="font-weight: bold;">
                Out of stock
              </p>
            <% end %>
          <% end %>
          <div class="d-flex justify-content-between mb-3">
            <% if user_signed_in?%>
              <% if current_user.admin? || current_user.staff? %>
                <%= link_to "Update", edit_product_path(@product), class: "btn btn-primary btn-lg" %>
              <% end %>
              <% if current_user.admin? %>
                <%= button_to "Delete", product_path(@product), class: "btn btn-danger btn-lg", method: :delete, data: { confirm: "Are you sure?" } %>
              <% end %>
            <% end %>
          </div>
          <% if user_signed_in? %>
            <% if current_order.order_items.find_by(product_id: @product.id)%>
              <%= link_to "Go to cart", carts_path, class: "btn btn-success btn-lg w-100 mt-3"%>
            <% else %>
              <%= form_for(@order_item, remote: true) do |f| %>
                <%= f.hidden_field :product_id, value: @product.id %>
                <div class="form-group">
                  <%= f.text_field :quantity, value: 1, min: 1, class: "form-control form-control-lg" %>
                </div>
                <%= f.submit "Add to Cart", class: "btn btn-success btn-lg w-100 mt-3" %>
              <% end %>
            <% end %>
          <% else %>
            <div class="alert alert-info text-center">
              <p class="mb-3" style="font-size: 18px;">Please sign in to purchase this item.</p>
              <%= link_to 'Log in', new_user_session_path, class: 'btn btn-primary me-2' %>
              <%= link_to 'Sign up', new_user_registration_path, class: 'btn btn-success' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
