<div class="container-fluid mt-4">
  <div id="carouselExampleCaptions" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <%= image_tag("ban1.jpg", class: "d-block w-100", alt: "Banner 1") %>
      </div>
      <div class="carousel-item">
        <%= image_tag("ban2.jpg", class: "d-block w-100", alt: "Banner 2") %>
      </div>
      <div class="carousel-item">
        <%= image_tag("ban3.jpg", class: "d-block w-100", alt: "Banner 3") %>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>

  <div class="row">
    <h1 class="text-center mb-5">Products</h1>

    <div class="col-md-2 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">Filter By</h5>
        </div>
        <div class="card-body">
          <%= search_form_for @q, url: products_path, method: :get, local: true, class: "filter-form" do |f| %>
            <div class="mb-3">
              <%= f.label :name_cont, "Search by Name", class: "form-label" %>
              <%= f.search_field :name_cont, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :price_gteq, "Min Price", class: "form-label" %>
              <%= f.number_field :price_gteq, class: "form-control", step: "0.01" %>
            </div>
            <div class="mb-3">
              <%= f.label :price_lteq, "Max Price", class: "form-label" %>
              <%= f.number_field :price_lteq, class: "form-control", step: "0.01" %>
            </div>
            <div class="mb-3">
              <%= f.label :s, "Sort By", class: "form-label" %>
              <%= f.select :s, [['Price Low to High', 'price asc'], ['Price High to Low', 'price desc'], ['Name A to Z', 'name asc']], {}, class: "form-select" %>
            </div>
            <%= f.submit 'Apply Filters', class: "btn btn-primary w-100" %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-10">
      <div class="row">
        <%= render "card" %>
      </div>
      <div class="d-flex justify-content-center mt-4">
        <%= will_paginate @products, renderer: WillPaginate::ActionView::BootstrapLinkRenderer, class: "pagination" %>
      </div>
    </div>
  </div>
</div>
