<div class="container mt-4">
  <div class="row">
    <% @products.each do |p| %>
      <div class="col-md-3 mb-4">
        <%= link_to product_path(p), class: "card h-100 text-decoration-none border-0 shadow-lg" do %>
          <% if p.photo.attached? %>
            <%= image_tag(p.photo, class: "card-img-top", alt: "Product image", style: "height: 200px; object-fit: cover; border-bottom: 1px solid #e0e0e0; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);") %>
          <% else %>
            <%= image_tag("no.jpg", class: "card-img-top", alt: "No image available", style: "height: 200px; object-fit: cover; border-bottom: 1px solid #e0e0e0; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);") %>
          <% end %>
          <div class="card-body d-flex flex-column p-3">
            <h5 class="card-title text-dark mb-2 font-weight-bold"><%= p.name %></h5>
            <p class="card-text text-muted mb-3" style="flex-grow: 1;"><%= truncate(p.description, length: 60) %></p>
            <p class="h5 text-danger mb-2"><strong><%= number_to_currency(p.price, unit: "$") %></strong></p>
            <% if p.stock.nil? || p.stock <= 0 %>
              <p class="card-text text-danger mb-2"><i class="fas fa-times-circle"></i> Out of Stock</p>
            <% elsif p.stock > 10 %>
              <p class="card-text text-success mb-2"><i class="fas fa-check-circle"></i> In Stock</p>
            <% else %>
              <p class="card-text text-warning mb-2"><i class="fas fa-exclamation-circle"></i> Only <%= p.stock %> left in stock</p>
            <% end %>
          </div>
          <div class="card-footer text-center bg-transparent border-0 p-3">
            <%= button_to 'Buy Now', product_path(p), class: 'btn btn-warning w-100 text-uppercase font-weight-bold', method: :get %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
