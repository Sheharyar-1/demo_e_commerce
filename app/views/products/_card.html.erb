<div class="container mt-4">

  <div class="row">
  <% @products.each do |p| %>
    <div class="col-md-3 mb-4">
      <div class="card h-100">
        <% if p.photo.attached? %>
          <%= image_tag(p.photo, class: "card-img-top", alt: "Card image cap") %>
        <%else%>
          <%= image_tag("no.jpg", class: "card-img-top", alt: "Card image cap") %>
        <%end%>
        <div class="card-body">
          <h4 class="card-title text-center"><%= p.name %></h4>
          <p class="card-text"><%= p.description %></p>
        </div>
        <div class="card-footer text-center">
          <%= link_to "#{p.price}$", product_path(p), class: "btn btn-primary" %>
          <p class="card-text"><%= p.total_quantity %></p>
        </div>
      </div>
    </div>
  <% end %>
  </div>
</div>
