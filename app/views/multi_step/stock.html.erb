<%= form_with model: @product, url: wizard_path do |f| %>
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <h1>Product Stock</h1>

            <div class="mb-3">
              <%= f.label :total_quantity, class: 'form-label' %>
              <%= f.number_field :total_quantity, class: 'form-control', required: true %>
              <div class="invalid-feedback">
                Please provide the total quantity.
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :quantity_in_stock, class: 'form-label' %>
              <%= f.number_field :quantity_in_stock, class: 'form-control', required: true %>
              <div class="invalid-feedback">
                Please provide the quantity in stock.
              </div>
            </div>

            <div>
              <%= f.submit 'Next', class: 'btn btn-primary' %>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
